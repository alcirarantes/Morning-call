      <p style="font-size:13px;color:var(--gray-800);line-height:1.75;margin-bottom:10px;"><p style="font-size:13px;color:var(--gray-800);line-height:1.75;margin-bottom:10px;">{{LEITURA_IPCA_DRIVERS}}</p>
