<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Morning Call · Alcir Arantes · {{DATA_META}}</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --brand:        #1A4731;
  --brand-dark:   #0E2B1C;
  --brand-mid:    #1D5438;
  --brand-pale:   #E8F2EC;
  --accent:       #8B5A00;
  --accent-light: #B07820;
  --accent-pale:  #FBF3E3;
  --white:        #FFFFFF;
  --off-white:    #F5F6F3;
  --gray-50:      #F8F9F7;
  --gray-100:     #EDEEED;
  --gray-200:     #D8DAD5;
  --gray-400:     #929990;
  --gray-600:     #5A6257;
  --gray-800:     #2A3027;
  --black:        #151B12;
  --positive:     #156637;
  --pos-bg:       #E6F4EC;
  --negative:     #7A1A1A;
  --neg-bg:       #FAEAEA;
  --warn:         #7A4A00;
  --warn-bg:      #FBF3E3;
  --fd:  'Playfair Display', serif;
  --fb:  'Plus Jakarta Sans', sans-serif;
  --fm:  'DM Mono', monospace;
  --r1: 6px; --r2: 10px; --r3: 14px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%;
  background: var(--off-white);
  font-family: var(--fb);
  color: var(--black);
  font-size: 14px;
  line-height: 1.6;
}
.wrapper { width: 100%; background: var(--white); }

/* TOPBAR */
.topbar {
  background: var(--brand-dark);
  padding: 9px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.topbar a { color: rgba(255,255,255,.38); text-decoration: none; font-family: var(--fm); font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; transition: color .2s; }
.topbar a:hover { color: #fff; }
.topbar-ed { font-family: var(--fm); font-size: 10px; color: rgba(255,255,255,.22); letter-spacing: 1px; text-transform: uppercase; }

/* HEADER */
.header {
  background: var(--brand-dark);
  padding: 44px 40px 38px;
  position: relative;
  overflow: hidden;
}
.header::before {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 55% 70% at 92% 8%, rgba(176,120,32,.1) 0%, transparent 55%),
    radial-gradient(ellipse 35% 55% at 5% 95%, rgba(255,255,255,.03) 0%, transparent 50%);
  pointer-events: none;
}
.header::after {
  content: '';
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 3px;
  background: linear-gradient(to bottom, var(--accent-light) 0%, var(--brand-mid) 100%);
}
.h-inner { position: relative; z-index: 1; }
.h-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; }
.brand-label { font-family: var(--fm); font-size: 9px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--accent-light); margin-bottom: 5px; }
.brand-name { font-family: var(--fb); font-size: 17px; font-weight: 700; color: #fff; }
.brand-handle { font-family: var(--fm); font-size: 11px; color: rgba(255,255,255,.36); margin-top: 2px; }
.date-day { font-family: var(--fd); font-size: 68px; font-weight: 900; line-height: 1; color: rgba(255,255,255,.07); letter-spacing: -4px; text-align: right; }
.date-meta { font-family: var(--fm); font-size: 10px; color: rgba(255,255,255,.35); letter-spacing: 1.5px; text-transform: uppercase; text-align: right; margin-top: 4px; }
.h-divider { border: none; border-top: 1px solid rgba(255,255,255,.1); margin-bottom: 14px; }
.h-eyebrow { font-family: var(--fm); font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,.28); margin-bottom: 12px; }
.h-headline {
  font-family: var(--fd);
  font-size: 27px;
  font-weight: 800;
  color: #fff;
  line-height: 1.28;
  letter-spacing: -.2px;
  max-width: 700px;
}
.h-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px; }
.tag {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 4px 11px; border-radius: 4px;
  font-family: var(--fm); font-size: 9px; font-weight: 500;
  letter-spacing: .8px; text-transform: uppercase;
}
.t-primary { background: rgba(176,120,32,.18); color: #D4A84B; border: 1px solid rgba(176,120,32,.25); }
.t-secondary { background: rgba(255,255,255,.06); color: rgba(255,255,255,.42); border: 1px solid rgba(255,255,255,.08); }
.tag-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: .7; flex-shrink: 0; }

/* TICKER */
.ticker {
  background: #081510;
  border-top: 2px solid rgba(255,255,255,.1);
  padding: 0 40px;
  display: flex;
  overflow-x: auto;
  scrollbar-width: none;
}
.ticker::-webkit-scrollbar { display: none; }
.t-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 15px 28px 15px 0;
  margin-right: 28px;
  border-right: 1px solid rgba(255,255,255,.1);
  flex-shrink: 0;
  gap: 5px;
}
.t-item:last-child { border-right: none; }
.t-lbl {
  font-family: var(--fm);
  font-size: 10px;
  color: rgba(255,255,255,.65);
  letter-spacing: 1.8px;
  text-transform: uppercase;
  font-weight: 500;
}
.t-row { display: flex; align-items: baseline; gap: 9px; }
.t-val {
  font-family: var(--fm);
  font-size: 15px;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: -.2px;
}
.t-chg {
  font-family: var(--fm);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .2px;
}
.cup  { color: #3DD68C; }
.cdn  { color: #FF6B6B; }
.cwrn { color: #F0B429; }
.cneu { color: rgba(255,255,255,.4); }

/* BODY */
.body { background: var(--white); }

/* SECTION DIVIDER — faixa verde escura com título branco */
.sec-divider {
  background: var(--brand-dark);
  border: none;
  padding: 11px 40px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.sec-divider-num {
  font-family: var(--fm);
  font-size: 9px;
  color: var(--accent-light);
  letter-spacing: 2.5px;
  text-transform: uppercase;
  font-weight: 500;
  opacity: .85;
}
.sec-divider-sep { color: rgba(255,255,255,.2); font-size: 11px; }
.sec-divider-title {
  font-family: var(--fb);
  font-size: 12px;
  font-weight: 700;
  color: #FFFFFF;
  text-transform: uppercase;
  letter-spacing: .8px;
}

/* SECTION BODY */
.sec { padding: 32px 40px; border-bottom: 1px solid var(--gray-100); }
.sec:last-child { border-bottom: none; }

.sec-title { font-family: var(--fd); font-size: 20px; font-weight: 800; color: var(--black); margin-bottom: 6px; line-height: 1.2; letter-spacing: -.2px; }
.sec-sub { font-size: 12px; color: var(--gray-400); margin-bottom: 22px; }

/* PANORAMA INTRO — estilo lead jornalístico */
.lead {
  font-family: var(--fb);
  font-size: 15px;
  font-weight: 400;
  color: var(--gray-800);
  line-height: 1.75;
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--gray-100);
}
.lead strong { color: var(--black); font-weight: 600; }

/* BULLETS — estilo newsletter */
.bullets { list-style: none; }
.bullets li {
  padding: 13px 0;
  border-bottom: 1px solid var(--gray-100);
  font-size: 13.5px;
  color: var(--gray-700, #444);
  line-height: 1.7;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.bullets li:last-child { border-bottom: none; }
.bullet-head {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.bullet-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--brand);
  flex-shrink: 0;
  margin-top: 7px;
}
.bullet-title { font-weight: 600; color: var(--black); font-size: 13.5px; }
.bullet-body {
  font-size: 13px;
  color: var(--gray-600);
  line-height: 1.7;
  padding-left: 16px;
}
.bullet-body strong { color: var(--black); font-weight: 600; }

/* CALLOUT */
.callout {
  background: var(--brand-pale);
  border-left: 3px solid var(--brand);
  padding: 14px 16px;
  border-radius: 0 var(--r2) var(--r2) 0;
  margin-bottom: 20px;
}
.callout-lbl {
  font-family: var(--fm); font-size: 9px; color: var(--brand);
  letter-spacing: 2px; text-transform: uppercase;
  margin-bottom: 5px; font-weight: 500;
  display: flex; align-items: center; gap: 5px;
}
.callout-lbl-dot { width: 5px; height: 5px; background: var(--brand); border-radius: 50%; flex-shrink: 0; }
.callout p { font-size: 13px; color: var(--gray-800); line-height: 1.65; }
.callout strong { color: var(--brand-dark); font-weight: 600; }
.callout.alert { background: var(--warn-bg); border-color: var(--accent); }
.callout.alert .callout-lbl { color: var(--accent); }
.callout.alert .callout-lbl-dot { background: var(--accent); }
.callout.alert strong { color: var(--accent); }

/* COTAÇÕES — tabela estruturada por categoria */
.quotes-wrap { margin-top: 4px; display: flex; flex-direction: column; gap: 0; }

.q-category {
  border: 1px solid var(--gray-200);
  border-radius: var(--r2);
  overflow: hidden;
  margin-bottom: 10px;
}
.q-category:last-child { margin-bottom: 0; }

.q-cat-header {
  background: var(--brand-dark);
  padding: 8px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.q-cat-title {
  font-family: var(--fm);
  font-size: 9px;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2px;
  text-transform: uppercase;
}
.q-cat-dot {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--accent-light);
  flex-shrink: 0;
}

.q-table { width: 100%; border-collapse: collapse; }
.q-table tr { border-bottom: 1px solid var(--gray-100); }
.q-table tr:last-child { border-bottom: none; }
.q-table tr:hover { background: var(--gray-50); }
.q-table td {
  padding: 10px 16px;
  font-size: 13px;
  vertical-align: middle;
}
.q-table .td-name {
  font-weight: 600;
  color: var(--gray-800);
  width: 40%;
}
.q-table .td-val {
  font-family: var(--fm);
  font-size: 13px;
  color: var(--black);
  font-weight: 500;
  width: 30%;
}
.q-table .td-chg {
  font-family: var(--fm);
  font-size: 13px;
  font-weight: 700;
  text-align: right;
  width: 30%;
}
/* Verde = número positivo / Vermelho = número negativo */
.qp { color: #0E7A3C; }
.qn { color: #A01C1C; }
.qw { color: var(--accent); }

/* AGENDA TABLE */
.agenda { margin-top: 4px; }
.ag-item {
  display: flex; gap: 14px; padding: 11px 0;
  border-bottom: 1px solid var(--gray-100);
  align-items: flex-start;
}
.ag-item:last-child { border-bottom: none; }
.ag-time {
  font-family: var(--fm); font-size: 11px; font-weight: 500;
  color: var(--brand-dark); background: var(--brand-pale);
  padding: 3px 9px; border-radius: var(--r1);
  min-width: 50px; text-align: center; flex-shrink: 0;
  border: 1px solid rgba(26,71,49,.1);
}
.ag-name { font-size: 13px; font-weight: 600; color: var(--black); }
.ag-meta { font-size: 11px; color: var(--gray-400); margin-top: 2px; line-height: 1.5; }

/* CORP ITEMS */
.corp-list { margin-top: 4px; }
.corp-item {
  padding: 13px 0; border-bottom: 1px solid var(--gray-100);
  display: flex; flex-direction: column; gap: 5px;
}
.corp-item:last-child { border-bottom: none; }
.corp-head { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
.corp-ticker {
  font-family: var(--fm); font-size: 10px; font-weight: 600;
  color: var(--brand); background: var(--brand-pale);
  padding: 2px 7px; border-radius: var(--r1); letter-spacing: .5px;
}
.corp-name { font-size: 13px; font-weight: 600; color: var(--black); }
.corp-badge {
  font-family: var(--fm); font-size: 9px; letter-spacing: .5px;
  padding: 2px 7px; border-radius: var(--r1); text-transform: uppercase;
}
.b-div    { background: var(--pos-bg); color: var(--positive); }
.b-res    { background: var(--brand-pale); color: var(--brand); }
.b-alert  { background: var(--warn-bg); color: var(--warn); }
.b-neg    { background: var(--neg-bg); color: var(--negative); }
.corp-desc { font-size: 13px; color: var(--gray-600); line-height: 1.65; }

/* QUOTE BLOCK */
.quote-sec {
  background: var(--brand-dark); padding: 44px 40px;
  text-align: center; position: relative; overflow: hidden;
}
.quote-sec::before {
  content: '\201C';
  position: absolute; top: -16px; left: 28px;
  font-family: Georgia, serif; font-size: 160px;
  color: rgba(176,120,32,.1); line-height: 1; pointer-events: none;
}
.q-text {
  font-family: var(--fd); font-size: 18px; font-weight: 700;
  color: #E8EEE9; line-height: 1.6; font-style: italic;
  position: relative; z-index: 1; max-width: 520px; margin: 0 auto;
}
.q-author {
  font-family: var(--fm); font-size: 10px; color: var(--accent-light);
  letter-spacing: 1.5px; margin-top: 14px; text-transform: uppercase;
  position: relative; z-index: 1;
}

/* CLOSING */
.closing { background: var(--black); padding: 34px 40px; position: relative; overflow: hidden; }
.closing::before {
  content: ''; position: absolute; top: 0; right: 0;
  width: 260px; height: 260px;
  background: radial-gradient(circle, rgba(139,90,0,.12) 0%, transparent 70%);
  pointer-events: none;
}
.closing-lbl { font-family: var(--fm); font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--accent-light); margin-bottom: 10px; }
.closing p { font-size: 14px; color: #8FA898; line-height: 1.8; position: relative; z-index: 1; }
.closing strong { color: var(--accent-light); }

/* FOOTER */
.footer {
  background: var(--brand-dark); padding: 26px 40px;
  display: flex; justify-content: space-between; align-items: center; gap: 20px;
}
.f-name { font-family: var(--fb); font-size: 14px; font-weight: 700; color: #fff; }
.f-title { font-family: var(--fm); font-size: 10px; color: rgba(255,255,255,.3); letter-spacing: .4px; margin-top: 2px; }
.f-handle { font-family: var(--fm); font-size: 11px; color: var(--accent-light); margin-top: 3px; }
.f-disc { font-size: 10px; color: rgba(255,255,255,.14); line-height: 1.6; max-width: 380px; text-align: right; }

/* FAB */
.fab {
  position: fixed; bottom: 24px; right: 24px; z-index: 999;
  width: 52px; height: 52px; border-radius: 50%;
  background: #25D366; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 16px rgba(37,211,102,.32);
  transition: transform .2s, box-shadow .2s; text-decoration: none;
}
.fab:hover { transform: scale(1.08); box-shadow: 0 6px 22px rgba(37,211,102,.42); }
.fab svg { width: 26px; height: 26px; fill: #fff; }

/* ANIMATIONS */
@keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
.anim { animation: fadeUp .5s ease-out forwards; opacity: 0; }
.d1{animation-delay:.1s} .d2{animation-delay:.2s} .d3{animation-delay:.3s} .d4{animation-delay:.4s}

/* RESPONSIVE */
@media(max-width:600px){
  .topbar,.header,.sec,.ticker,.quote-sec,.closing,.footer,.sec-divider{padding-left:20px;padding-right:20px}
  .h-headline{font-size:22px}
  .date-day{font-size:50px}
  .footer{flex-direction:column;align-items:flex-start}
  .f-disc{text-align:left}
  .quotes-grid{grid-template-columns:1fr 1fr}
}
</style>
</head>
<body>
<div class="wrapper">

<!-- TOPBAR -->
<div class="topbar">
  <a href="/">&#8592; Todos os Morning Calls</a>
  <span class="topbar-ed">{{EDICAO}}</span>
</div>

<!-- HEADER -->
<div class="header">
  <div class="h-inner">
    <div class="h-top">
      <div>
        <div class="brand-label">Morning Call · Análise de Mercado</div>
        <div class="brand-name">Alcir Arantes</div>
        <div class="brand-handle">@alcirarantes</div>
      </div>
      <div>
        <div class="date-day">{{DATA_DIA}}</div>
        <div class="date-meta">{{DATA_META}}</div>
      </div>
    </div>
    <hr class="h-divider">
    <div class="h-eyebrow">A história do dia</div>
    <div class="h-headline">{{MANCHETE}}</div>
    <div class="h-tags">
      <span class="tag t-primary"><span class="tag-dot"></span>Conflito Oriente Médio · Dia 27</span>
      <span class="tag t-primary"><span class="tag-dot"></span>Brent US$ 101</span>
      <span class="tag t-secondary">IPCA-15 {{IPCA_RESULTADO}}</span>
      <span class="tag t-secondary">RPM · Galípolo 11h</span>
      <span class="tag t-secondary">Selic {{SELIC_VAL}}</span>
    </div>
  </div>
</div>

<!-- TICKER BAR -->
<div class="ticker">
  <div class="t-item"><div class="t-lbl">IBOV fech.</div><div class="t-row"><span class="t-val">{{IBOV_FECH_VAL}}</span><span class="t-chg {{IBOV_FECH_CSS}}">{{IBOV_FECH_CHG}}</span></div></div>
  <div class="t-item"><div class="t-lbl">IBOV agora</div><div class="t-row"><span class="t-val">{{IBOV_NOW_VAL}}</span><span class="t-chg {{IBOV_NOW_CSS}}">{{IBOV_NOW_CHG}}</span></div></div>
  <div class="t-item"><div class="t-lbl">USD/BRL</div><div class="t-row"><span class="t-val">R$ {{USDBRL_VAL}}</span><span class="t-chg cdn">+0,32%</span></div></div>
  <div class="t-item"><div class="t-lbl">S&P 500 Fut</div><div class="t-row"><span class="t-val">{{SP500F_VAL}}</span><span class="t-chg cdn">-0,75%</span></div></div>
  <div class="t-item"><div class="t-lbl">Brent</div><div class="t-row"><span class="t-val">US$ {{BRENT_VAL}}</span><span class="t-chg cdn">+3,81%</span></div></div>
  <div class="t-item"><div class="t-lbl">Selic</div><div class="t-row"><span class="t-val">{{SELIC_VAL}}</span><span class="t-chg cwrn">meta vigente</span></div></div>
  <div class="t-item"><div class="t-lbl">VIX</div><div class="t-row"><span class="t-val">{{VIX_VAL}}</span><span class="t-chg {{VIX_CSS}}">{{VIX_CHG}}</span></div></div>
  <div class="t-item"><div class="t-lbl">BTC</div><div class="t-row"><span class="t-val">US$ 69.380</span><span class="t-chg cdn">-2,18%</span></div></div>
</div>

<!-- BODY -->
<div class="body">

<!-- ── PANORAMA ── -->
<div class="sec-divider anim">
  <span class="sec-divider-num">Panorama</span>
  <span class="sec-divider-sep">·</span>
  <span class="sec-divider-title">A história do dia</span>
</div>
<div class="sec anim">
  <p class="lead">
    {{PANORAMA_P1}}
  </p>
  <p class="lead" style="padding-bottom:0;border-bottom:none;margin-bottom:0;">
    {{PANORAMA_P2}}
  </p>
</div>

<!-- ── BRASIL ── -->
<div class="sec-divider anim d1">
  <span class="sec-divider-num">01</span>
  <span class="sec-divider-sep">·</span>
  <span class="sec-divider-title">Brasil — Doméstico</span>
</div>
<div class="sec anim d1">

  <!-- INDICADOR: IPCA-15 com leitura de mercado -->
  <div style="border:1px solid var(--gray-200);border-radius:var(--r2);overflow:hidden;margin-bottom:24px;">
    <!-- Header do indicador -->
    <div style="background:var(--brand-dark);padding:11px 18px;display:flex;justify-content:space-between;align-items:center;">
      <div style="display:flex;align-items:center;gap:9px;">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--accent-light);flex-shrink:0;display:inline-block;"></span>
        <span style="font-family:var(--fm);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#fff;font-weight:600;">IPCA-15 · Março 2026 · IBGE</span>
      </div>
      <span style="font-family:var(--fm);font-size:10px;color:rgba(255,255,255,.5);letter-spacing:1.2px;text-transform:uppercase;">Divulgado hoje · 09h00</span>
    </div>
    <!-- Números principais -->
    <div style="display:flex;border-bottom:1px solid var(--gray-100);">
      <div style="flex:1;padding:16px 18px;border-right:1px solid var(--gray-100);">
        <div style="font-family:var(--fm);font-size:10px;color:var(--gray-400);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:6px;font-weight:500;">Resultado</div>
        <div style="font-family:'Playfair Display',serif;font-size:30px;font-weight:800;color:#A01C1C;line-height:1;letter-spacing:-.5px;">{{IPCA_RESULTADO}}</div>
        <div style="font-family:var(--fm);font-size:11px;color:#A01C1C;margin-top:5px;font-weight:700;letter-spacing:.3px;">acima do esperado</div>
